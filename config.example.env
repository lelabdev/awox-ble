# Copy to ~/.config/awox-mesh/config.env and set permissions to 0600.
# Replace ALL example values with those of your own Bluetooth light.
# NEVER commit the populated config.env or share it in an issue.
AWOX_MAC=AA:BB:CC:DD:EE:FF
AWOX_MESH_NAME=your_mesh_name
AWOX_MESH_PASSWORD=your_local_mesh_password
AWOX_MESH_ID=0x1234
AWOX_BACKEND=gatt
