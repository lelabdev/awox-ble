[Unit]
Description=awox-ble - local AwoX / EGLO BLE lamp controller
After=bluetooth.target

[Service]
Type=simple
ExecStart=%h/1Dev/Projects/awox-ble/.venv/bin/awox-ble-daemon
WorkingDirectory=%h/1Dev/Projects/awox-ble
Environment=PYTHONUNBUFFERED=1
Environment=AWOX_BLE_IDLE_SECONDS=120
Environment=AWOX_BLE_PRESET_DELAY=2.5
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
